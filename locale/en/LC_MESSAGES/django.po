msgid "只有 1 筆紀錄，再累積至少 1 筆才算得出趨勢。"
msgstr ""
"Only 1 record — at least 1 more is needed before a trend means anything."

#: .\analytics\services.py:937
msgid "這段紀錄有 "
msgstr "This stretch of records includes "

#: .\analytics\services.py:938
#, python-format
msgid "%(v0)s（%(v1)s 天）"
msgstr "%(v0)s (%(v1)s days)"

