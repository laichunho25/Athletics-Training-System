# 預設由 git 自行判斷
* text=auto

# 這些檔案在 Linux（Render）上執行，必須是 LF，否則 bash 會報 $'\r': command not found
*.sh          text eol=lf
build.sh      text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf

# Windows 批次檔必須是 CRLF
*.bat         text eol=crlf

# 二進位檔不要轉換
*.png binary
*.jpg binary
*.ico binary
