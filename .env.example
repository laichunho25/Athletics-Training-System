# 複製成 .env 供本機使用；正式值請設在 Render → Environment（不要提交進 git）
DJANGO_SECRET_KEY=請換成隨機長字串
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=www.hohosports.com,hohosports.com
# DATABASE_URL=postgresql://user:pass@host:5432/atm
# DJANGO_MEDIA_ROOT=/var/data/media
# 後台網址（正式站請換成不好猜的路徑，換掉之後 /admin/ 就是 404）
# DJANGO_ADMIN_URL=atm-console-4b91
# 選用：把後台鎖到指定帳號（逗號分隔）
# DJANGO_ADMIN_ALLOWED_USERS=coachlai
# 選用：餐點相片辨識（沒有設就用文字比對食物字典，功能不會壞）
# ANTHROPIC_API_KEY=sk-ant-...
# 選用：影片庫的雲端儲存（Cloudflare R2）。
# 四個都設齊才會啟用，屆時瀏覽器會把影片直傳 R2，不經過 Django；
# 沒設就存在本機 MEDIA_ROOT（本機開發夠用，正式站不行——容器會重置）。
# R2_BUCKET=atm-videos
# R2_ACCOUNT_ID=你的 Cloudflare account id
# R2_ACCESS_KEY_ID=...
# R2_SECRET_ACCESS_KEY=...
# 選用：自訂 endpoint（預設 https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com）
# R2_ENDPOINT=
# 選用：綁了自訂網域做公開讀取就填，留空則每次播放都簽一條有時效的網址
# R2_PUBLIC_BASE=https://videos.hohosports.com
